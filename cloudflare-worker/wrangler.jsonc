{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thedivision2-daily-loot-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "1 8 * * *",
      "2 8 * * *"
    ]
  }
}
