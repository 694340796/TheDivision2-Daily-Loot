{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thedivision2-daily-loot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
